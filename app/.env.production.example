# Smartexam by AILO: konfigurasi PRODUCTION. Salin ke /var/www/smartexam/app/.env.local di server, lalu isi semua yang bertanda ISI.
# Berkas ini hanya contoh dan boleh di-commit; .env.local yang berisi nilai asli tidak boleh.
# Penjelasan tiap variabel ada di .env.example.

NODE_ENV=production
APP_URL=https://ISI-domain-anda.example.com
INTERNAL_URL=http://127.0.0.1:4100

# Database dan kunci (buat di server; simpan salinan di pengelola kata sandi)
MONGODB_URI=ISI
JWT_SECRET=ISI-hex-96-karakter
FIELD_ENCRYPTION_KEY=ISI-base64-32-byte
CRON_SECRET=ISI-hex-96-karakter
ADMIN_EMAILS=ISI-email-admin-pertama@domain.com

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=ISI
MAIL_APP_PASSWORD=ISI
MAIL_FROM="Smartexam by AILO <ISI@domain-anda.com>"

# Penjadwal: satu instance PM2, jadi dijalankan di dalam proses
ENABLE_INPROCESS_CRON=true

# AI (opsional; kosongkan bila belum ada kunci)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

BACKUP_DIR=/var/backups/smartexam
