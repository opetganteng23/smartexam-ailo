# Smartexam by AILO: contoh konfigurasi. Salin ke .env.local (lokal) atau .env.local di server (production), lalu isi.
# .env.local TIDAK pernah di-commit. Jangan menaruh nilai rahasia di berkas ini.

# ============================================================================
# 1. WAJIB DI PRODUCTION (di lokal boleh dikosongkan, kecuali JWT_SECRET)
# ============================================================================

# Alamat publik aplikasi, tanpa garis miring di akhir. Dipakai di tautan email, undangan, dan pengecekan Origin.
APP_URL=http://localhost:3000

# MongoDB. Kosongkan di lokal untuk memakai MongoDB in-memory (data hilang saat server berhenti).
# Production: Atlas (mongodb+srv://...) atau MongoDB di VM (mongodb://user:pass@127.0.0.1:27017/smartexam?authSource=admin)
MONGODB_URI=

# Kunci penanda tangan sesi. Acak, minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Kunci enkripsi NIK dan data sensitif (32 byte, base64). SIMPAN dan jangan diganti setelah ada data:
# data yang sudah terenkripsi tidak bisa dibaca lagi bila kunci berubah. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Email yang otomatis menjadi admin saat pertama kali masuk (pisahkan dengan koma)
ADMIN_EMAILS=

# Alamat aplikasi dari dalam server, dipakai middleware untuk cek mode pemeliharaan. Wajib di production.
# Harus sama dengan port di ecosystem.config.cjs (4100) dan Nginx.
INTERNAL_URL=http://127.0.0.1:4100

# ============================================================================
# 2. EMAIL (OTP, undangan, pengingat). Kosong di lokal: kode OTP dicetak ke konsol server.
# ============================================================================
# Gmail memakai App Password (bukan kata sandi akun) dan dibatasi ±500 email/hari.
# Untuk undangan massal, pakai SMTP transaksional dan ganti MAIL_HOST/PORT di bawah.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM="Smartexam by AILO <noreply@domain-anda.com>"

# ============================================================================
# 3. PENJADWAL
# ============================================================================
# Rahasia untuk memanggil /api/cron/* dari luar (header "Authorization: Bearer <CRON_SECRET>"). Acak, minimal 32 karakter.
CRON_SECRET=
# true = jalankan antrean email, job per jam, dan job harian di dalam proses (VPS + PM2, SATU instance saja).
# false = jadwalkan /api/cron/mail, /hourly, /daily lewat cron sistem.
ENABLE_INPROCESS_CRON=false

# ============================================================================
# 4. AI (opsional). Kosong: Konselor dan analisis memakai mode dasar berbasis aturan;
#    draf nilai essay dan generator soal AI tidak tersedia.
# ============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model lebih ringan untuk kuis kecil. Kosong = kuis memakai narasi template.
ANTHROPIC_MODEL_LIGHT=
# Batas panggilan Claude yang berjalan bersamaan (bawaan 8). Sesuaikan dengan batas akun Anthropic.
AI_CONCURRENCY=8

# ============================================================================
# 5. OPSIONAL LAINNYA
# ============================================================================
# Cloudflare Turnstile (captcha). Kosong = captcha gambar bawaan. Isi keduanya untuk mengaktifkan Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Folder untuk memantau backup MongoDB (berkas smartexam-*.archive.gz) di halaman Settings.
BACKUP_DIR=/var/backups/smartexam
# Folder cache audio (bawaan: .audio-cache di folder aplikasi).
AUDIO_CACHE_DIR=
# Pengali batas laju per IP (bawaan 1). Naikkan bila banyak peserta berbagi satu IP (satu kampus/kantor).
RATE_IP_FACTOR=1
